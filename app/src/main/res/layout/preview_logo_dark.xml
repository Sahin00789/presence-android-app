<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/presence_dark_bg"
    android:padding="@dimen/presence_logo_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/preview_title_dark"
            android:textColor="@color/presence_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. Primary Horizontal Logo (White Wordmark for Dark Mode) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_label_horizontal"
            android:textColor="@color/presence_cyan_accent"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/presence_logo_spacing_sm">

            <ImageView
                android:layout_width="@dimen/presence_logo_symbol_size_md"
                android:layout_height="@dimen/presence_logo_symbol_size_md"
                android:contentDescription="@string/presence_logo_description"
                android:src="@drawable/ic_logo_symbol_color" />

            <Space
                android:layout_width="@dimen/presence_logo_spacing_md"
                android:layout_height="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/presence_brand_name"
                android:textColor="@color/presence_white"
                android:textSize="@dimen/presence_logo_text_size_md"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Vertical Logo (Dark Mode Variant) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_vertical"
            android:textColor="@color/presence_cyan_accent"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/presence_logo_padding">

            <FrameLayout
                android:layout_width="@dimen/presence_logo_symbol_size_xl"
                android:layout_height="@dimen/presence_logo_symbol_size_xl"
                android:background="@drawable/bg_logo_icon_container"
                android:elevation="4dp"
                android:padding="@dimen/presence_logo_spacing_md">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/presence_logo_description"
                    android:src="@drawable/ic_logo_symbol_monochrome" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/presence_logo_spacing_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="@string/presence_brand_name"
                android:textColor="@color/presence_white"
                android:textSize="@dimen/presence_logo_text_size_lg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/presence_subtitle"
                android:textColor="#94A3B8"
                android:textSize="@dimen/presence_logo_subtitle_size" />
        </LinearLayout>

        <!-- 3. App Icon Preview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_app_icon"
            android:textColor="@color/presence_cyan_accent"
            android:textSize="12sp" />

        <include layout="@layout/logo_presence_app_icon" />

        <!-- 4. Monochrome / Vector Symbol -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_monochrome"
            android:textColor="@color/presence_cyan_accent"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="@dimen/presence_logo_symbol_size_lg"
            android:layout_height="@dimen/presence_logo_symbol_size_lg"
            android:contentDescription="@string/presence_logo_description"
            android:src="@drawable/ic_logo_symbol_monochrome" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/presence_light_bg"
    android:padding="@dimen/presence_logo_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/preview_title_light"
            android:textColor="@color/presence_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. Primary Horizontal Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/preview_label_horizontal"
            android:textColor="@color/presence_text_secondary"
            android:textSize="12sp" />

        <include layout="@layout/logo_presence_horizontal" />

        <!-- 2. Vertical Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_vertical"
            android:textColor="@color/presence_text_secondary"
            android:textSize="12sp" />

        <include layout="@layout/logo_presence_vertical" />

        <!-- 3. App Icon Preview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_app_icon"
            android:textColor="@color/presence_text_secondary"
            android:textSize="12sp" />

        <include layout="@layout/logo_presence_app_icon" />

        <!-- 4. Monochrome / Vector Symbol -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_label_monochrome"
            android:textColor="@color/presence_text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="@dimen/presence_logo_symbol_size_lg"
            android:layout_height="@dimen/presence_logo_symbol_size_lg"
            android:contentDescription="@string/presence_logo_description"
            android:src="@drawable/ic_logo_symbol_color" />

    </LinearLayout>
</ScrollView>

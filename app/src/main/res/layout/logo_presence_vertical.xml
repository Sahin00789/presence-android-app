<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/presence_logo_padding"
    tools:background="@color/presence_light_bg">

    <!-- Symbol Container -->
    <FrameLayout
        android:layout_width="@dimen/presence_logo_symbol_size_xl"
        android:layout_height="@dimen/presence_logo_symbol_size_xl"
        android:background="@drawable/bg_logo_icon_container"
        android:elevation="4dp"
        android:padding="@dimen/presence_logo_spacing_md">

        <ImageView
            android:id="@+id/logo_symbol_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/presence_logo_description"
            android:src="@drawable/ic_logo_symbol_monochrome" />
    </FrameLayout>

    <!-- Spacing -->
    <Space
        android:layout_width="0dp"
        android:layout_height="@dimen/presence_logo_spacing_md" />

    <!-- Wordmark Title -->
    <TextView
        android:id="@+id/logo_wordmark_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:letterSpacing="0.03"
        android:text="@string/presence_brand_name"
        android:textColor="@color/presence_navy"
        android:textSize="@dimen/presence_logo_text_size_lg"
        android:textStyle="bold" />

    <!-- Subtitle / Tagline -->
    <TextView
        android:id="@+id/logo_subtitle_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="@string/presence_subtitle"
        android:textColor="@color/presence_text_secondary"
        android:textSize="@dimen/presence_logo_subtitle_size" />

</LinearLayout>

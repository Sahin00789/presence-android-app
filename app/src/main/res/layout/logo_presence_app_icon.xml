<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/presence_logo_app_icon_size"
    android:layout_height="@dimen/presence_logo_app_icon_size"
    android:background="@drawable/bg_logo_icon_container"
    android:elevation="6dp"
    android:padding="16dp"
    tools:background="@color/presence_light_bg">

    <ImageView
        android:id="@+id/app_icon_symbol"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/presence_logo_description"
        android:src="@drawable/ic_logo_symbol_color" />

</FrameLayout>
